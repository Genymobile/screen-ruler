// Shared look, taken from the Python app's RulerTheme.qml.

export global Theme {
    out property <color> accent: #E6195E;
    out property <color> text: white;
    out property <color> panel: #1A1A1AE6;
    out property <color> shadow: #00000038;
    out property <length> radius: 5px;
    out property <string> mono: "monospace";
    out property <length> chip-font-size: 13px;
}
